# Copy to .env and load with: set -a; source .env; set +a
# Never commit .env.

# Required for station data. Create one at https://explore.openaq.org
OPENAQ_API_KEY=your-openaq-api-key

# Required only for the publish command
FIREBASE_DB_URL=https://your-project-default-rtdb.your-region.firebasedatabase.app
# Service account key contents on one line (role: Firebase Realtime Database Admin)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional overrides
PM25_LATITUDE=13.7563
PM25_LONGITUDE=100.5018
REFERENCE_START=2022-08-01
OPENAQ_START=2021-04-29
OPENAQ_LOOKBACK_DAYS=14
PM25_DATA_DIR=data
PM25_MODELS_DIR=models
